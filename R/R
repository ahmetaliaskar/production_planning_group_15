# ---------------------------------------------------------------------
# 3) CALCULATIONS (SERVER)
# ---------------------------------------------------------------------
disaggregation_server <- function(id, ap) {
  moduleServer(id, function(input, output, session) {
    families <- reactive(parse_families(input$families))

    X <- reactive({
      if (input$source == "data") {
        a <- ap_require(ap)
        setNames(pmax(a$Dnet, 0), a$periods)
      } else {
        x <- as_number(trimws(strsplit(input$X, ",")[[1]]))
        validate(need(length(x) >= 1 && all(!is.na(x) & x >= 0),
                      "Type the X values as non-negative numbers separated by commas."))
        setNames(x, paste("Period", seq_along(x)))
      }
    })

    split <- reactive({
      f <- families(); x <- X()
      Y <- t(vapply(x, function(v) disaggregation_split(v, f$Setup, f$Demand, f$Lower, f$Upper),
                    numeric(nrow(f))))
      if (nrow(f) == 1) Y <- matrix(Y, ncol = 1)
      colnames(Y) <- f$Family
      Y
    })

    output$weight_table <- renderTable({
      f <- families()
      r <- sqrt(f$Setup * f$Demand)
      data.frame(Family = f$Family, "Setup cost K_j" = f$Setup, "Demand lambda_j" = f$Demand,
                 "sqrt(K_j lambda_j)" = round(r, 3), "Share (no bounds)" = round(r / sum(r), 4),
                 "Lower a_j" = f$Lower, "Upper b_j" = f$Upper, check.names = FALSE)
    })

    output$split_table <- renderTable({
      Y <- split(); x <- X(); f <- families()
      out <- data.frame(Period = names(x), "Aggregate X" = x, round(Y, 2), check.names = FALSE)
      out$Check <- ifelse(abs(rowSums(Y) - x) < 1e-6, "sum = X",
                          ifelse(x < sum(f$Lower), "X below sum of lower bounds",
                                 "X above sum of upper bounds"))
      out
    })

    output$split_plot <- renderPlot({
      Y <- split()
      barplot(t(Y), names.arg = names(X()), col = hcl.colors(ncol(Y), "Blues 3"),
              border = NA, legend.text = colnames(Y), ylab = "Units",
              main = "Aggregate production split among families",
              args.legend = list(bty = "n", x = "topright"))
    })
  })
}

# =====================================================================
# Topic: Simple Exponential Smoothing (SES)             (stationary series)
# Nahmias, Chapter 2
#
# S_t = alpha D_t + (1 - alpha) S_{t-1}        0 < alpha <= 1
# F_t = S_{t-1}   (forecast for period t made at the end of t-1)
# The forecast for every future period is S_n.
# Initial value S_0: from a regression line (its value at t = 0)
#                    or typed by the user.
# =====================================================================


# ---------------------------------------------------------------------
# 1) HELPER FUNCTIONS
# ---------------------------------------------------------------------

# Returns the smoothed values S_0..S_n and the forecasts F_1..F_n.
exponential_smoothing_run <- function(d, alpha, S0) {
  n <- length(d)
  S <- numeric(n)
  prev <- S0
  F <- numeric(n)
  for (t in 1:n) {
    F[t] <- prev
    S[t] <- alpha * d[t] + (1 - alpha) * prev
    prev <- S[t]
  }
  list(S = S, F = F)
}


# ---------------------------------------------------------------------
# 2) SCREEN (UI)
# ---------------------------------------------------------------------
exponential_smoothing_ui <- function(id) {
  ns <- NS(id)
  forecast_page(ns,
    "S_t = alpha D_t + (1 - alpha) S_(t-1);  F_t = S_(t-1).",
    parameter_mode_ui(ns,
      manual = numericInput(ns("alpha"), "alpha (0 < alpha <= 1)",
                            value = 0.2, min = 0.01, max = 1, step = 0.05)
    ),
    initial_values_ui(ns, slope = FALSE)
  )
}


# ---------------------------------------------------------------------
# 3) CALCULATIONS (SERVER)
# ---------------------------------------------------------------------
exponential_smoothing_server <- function(id) {
  moduleServer(id, function(input, output, session) {
    demand <- series_input_server("data")
    observeEvent(demand(), suggest_initial_values(session, demand()))

    result <- reactive({
      d <- demand(); n <- length(d)
      S0 <- initial_values(input, d)[["level"]]
      search <- NULL
      if (input$mode == "manual") {
        req(input$alpha)
        alpha <- input$alpha
        validate(need(alpha > 0 && alpha <= 1, "alpha must be in (0, 1]."))
      } else {
        search <- search_parameters(
          data.frame(alpha = seq(0.01, 1, by = 0.01)),
          function(p) forecast_errors(d, exponential_smoothing_run(d, p[["alpha"]], S0)$F, 1:n),
          input$criterion)
        alpha <- search$alpha[1]
      }
      run <- exponential_smoothing_run(d, alpha, S0)
      list(method  = paste0("Simple exponential smoothing (alpha = ", alpha, ")"),
           d = d, fitted = run$F,
           future  = rep(run$S[n], horizon(input)),
           periods = 1:n,
           params  = data.frame(Parameter = c("alpha", "S0 (initial level)"),
                                Value = c(alpha, S0)),
           detail  = data.frame("S_t" = run$S, check.names = FALSE),
           search  = search)
    })

    render_forecast_results(output, result)
  })
}

# =====================================================================
# Shared tools for all Forecasting modules
# Nahmias, Chapter 2
#
# Notation used in every module:
#   D_t  = observed demand in period t        (t = 1, ..., n)
#   F_t  = one-step-ahead forecast for period t, made at the end of t-1
#   e_t  = F_t - D_t                           (forecast error)
#   MAD  = mean of |e_t|
#   MSE  = mean of e_t^2
#   MAPE = mean of |e_t / D_t| x 100
#
# This file has no tab of its own. It contains:
#   1) reading Excel / csv files
