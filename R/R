  moduleServer(id, function(input, output, session) {
    result <- reactive({
      a <- ap_require(ap)
      W <- level_plan_workers(a)
      r <- ap_with_rounding(ap_build_plan(a, W),
                            function() ap_build_plan(a, ceiling(W - 1e-9)))
      r$title <- paste0("Constant-workforce (level) plan, W = ", round(W, 3))
