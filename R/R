# =====================================================================
# Topic: Forecasting with Moving Averages - MA(N)       (stationary series)
# Nahmias, Chapter 2
#
# MA(N) forecast:  F_t = (D_{t-1} + D_{t-2} + ... + D_{t-N}) / N
# The forecast for every future period is the last MA value.
# Shared tools (file reading, MAD/MSE/MAPE, outputs): forecast_common.R
# =====================================================================


# ---------------------------------------------------------------------
# 1) HELPER FUNCTIONS (the calculations; independent of the screen)
# ---------------------------------------------------------------------

# MA(N) forecasts for the demand vector d.
# The output has length n + 1: the last element is the next-period forecast.
# No forecast can be made for the first N periods (NA).
moving_average_forecast <- function(d, N) {
  n <- length(d)
  F <- rep(NA_real_, n + 1)
  for (t in (N + 1):(n + 1)) {
    F[t] <- mean(d[(t - N):(t - 1)])
  }
  F
}

# Tries every N = 1, 2, ..., Nmax.
# For a fair comparison, all N are evaluated over the SAME periods (Nmax+1 ... n).
moving_average_search <- function(d, Nmax, criterion) {
  search_parameters(
    data.frame(N = 1:Nmax),
    function(p) forecast_errors(d, moving_average_forecast(d, p[["N"]]),
                                (Nmax + 1):length(d)),
    criterion
  )
}


# ---------------------------------------------------------------------
# 2) SCREEN (UI)
# ---------------------------------------------------------------------
moving_average_ui <- function(id) {
  ns <- NS(id)
  forecast_page(ns,
    "F_t = average of the last N demands. For stationary series.",
    parameter_mode_ui(ns,
      manual = numericInput(ns("N"), "N (number of past periods)",
                            value = 3, min = 1, step = 1),
      auto   = numericInput(ns("Nmax"), "Largest N to try",
                            value = 12, min = 2, step = 1)
    )
  )
}


# ---------------------------------------------------------------------
# 3) CALCULATIONS (SERVER)
# ---------------------------------------------------------------------
moving_average_server <- function(id) {
  moduleServer(id, function(input, output, session) {
    demand <- series_input_server("data")

    result <- reactive({
      d <- demand(); n <- length(d)
      search <- NULL
      if (input$mode == "manual") {
        req(input$N)
        N <- as.integer(input$N)
        validate(need(N >= 1 && N < n, "N must be between 1 and n - 1."))
        start <- N + 1
      } else {
        req(input$Nmax)
        Nmax <- as.integer(input$Nmax)
        validate(need(Nmax >= 1 && Nmax < n,
                      "The largest N must be smaller than the number of observations."))
        search <- moving_average_search(d, Nmax, input$criterion)
        N <- search$N[1]
        start <- Nmax + 1
      }
      F <- moving_average_forecast(d, N)
      list(method  = paste0("Moving average MA(", N, ")"),
           d = d, fitted = F[1:n],
           future  = rep(F[n + 1], horizon(input)),
           periods = start:n,
           params  = data.frame(Parameter = "N", Value = N),
           search  = search)
    })

    render_forecast_results(output, result)
  })
}

# =====================================================================
# Topic: Seasonal decomposition with moving averages    (seasonal series)
# Nahmias, Chapter 2
#
# N = length of one season
# 1. Centered moving average CMA_t of length N
#      N odd : average of D_{t-(N-1)/2} ... D_{t+(N-1)/2}
#      N even: average of two neighbouring MA(N)s
#              = (D_{t-N/2}/2 + D_{t-N/2+1} + ... + D_{t+N/2-1} + D_{t+N/2}/2) / N
# 2. Ratios           D_t / CMA_t
# 3. Seasonal factor  c_j = average of the ratios of position j,
#                     scaled so that the factors add up to N
# 4. Deseasonalize    D_t / c_j
# 5. Fit a regression line a + b t to the deseasonalized series
# 6. Forecast         F_t = (a + b t) * c_j
# =====================================================================


# ---------------------------------------------------------------------
# 1) HELPER FUNCTIONS
# ---------------------------------------------------------------------
centered_moving_average <- function(d, N) {
  n <- length(d)
  cma <- rep(NA_real_, n)
  if (N %% 2 == 1) {
    k <- (N - 1) / 2
    for (t in (k + 1):(n - k)) cma[t] <- mean(d[(t - k):(t + k)])
  } else {
    k <- N / 2
    w <- c(0.5, rep(1, N - 1), 0.5) / N
    if (n > 2 * k) for (t in (k + 1):(n - k)) cma[t] <- sum(w * d[(t - k):(t + k)])
  }
  cma
}

seasonal_decomposition_run <- function(d, N) {
  n <- length(d)
  t <- 1:n
  pos <- season_position(t, N)
  cma <- centered_moving_average(d, N)
  ratio <- d / cma
  raw <- tapply(ratio, pos, mean, na.rm = TRUE)
  factors <- as.numeric(raw) * N / sum(raw)
  deseason <- d / factors[pos]
  fit <- stats::lm(deseason ~ t)
  a <- unname(stats::coef(fit)[1]); b <- unname(stats::coef(fit)[2])
  list(pos = pos, cma = cma, ratio = ratio, factors = factors,
       deseason = deseason, a = a, b = b,
       trend = a + b * t, fitted = (a + b * t) * factors[pos])
}


# ---------------------------------------------------------------------
# 2) SCREEN (UI)
# ---------------------------------------------------------------------
seasonal_decomposition_ui <- function(id) {
  ns <- NS(id)
  forecast_page(ns,
    "Centered MA -> seasonal factors -> deseasonalize -> trend line -> F_t = (a + b t) x c_j.",
    numericInput(ns("N"), "Season length N (e.g. 4 = quarters, 12 = months)",
                 value = 4, min = 2, step = 1),
    helpText("This method has no smoothing constant to search for;",
             "only the season length N is needed.")
  )
}


# ---------------------------------------------------------------------
# 3) CALCULATIONS (SERVER)
# ---------------------------------------------------------------------
seasonal_decomposition_server <- function(id) {
  moduleServer(id, function(input, output, session) {
    demand <- series_input_server("data")

    result <- reactive({
      d <- demand(); n <- length(d)
      req(input$N)
      N <- as.integer(input$N)
      validate(need(N >= 2 && n >= 2 * N,
                    "The data must contain at least two complete seasons."))
      r <- seasonal_decomposition_run(d, N)
      validate(need(all(!is.na(r$factors)),
                    "Not enough data to compute every seasonal factor."))
      h <- horizon(input)
      tf <- (n + 1):(n + h)
      list(method  = paste0("Seasonal decomposition, N = ", N,
                            ", trend line ", round(r$a, 3), " + ", round(r$b, 3), " t"),
           d = d, fitted = r$fitted,
           future  = (r$a + r$b * tf) * r$factors[season_position(tf, N)],
           periods = 1:n,
           params  = data.frame(
             Parameter = c("Trend intercept a", "Trend slope b", paste0("c", 1:N)),
             Value = c(r$a, r$b, r$factors)),
           detail  = data.frame("Season position" = r$pos,
                                "Centered MA" = r$cma,
                                "D_t / CMA" = r$ratio,
                                "Factor c_j" = r$factors[r$pos],
                                "Deseasonalized" = r$deseason,
                                "Trend a + b t" = r$trend,
                                check.names = FALSE))
    })

    render_forecast_results(output, result)
  })
}

# =====================================================================
# Topic: Seasonal factors - "quick and dirty" method
#        (stationary series with a seasonal pattern)
# Nahmias, Chapter 2
#
# N = length of one season (e.g. 4 quarters, 12 months)
# 1. Overall mean:      Dbar = mean of all demands in the complete seasons
# 2. Ratios:            D_t / Dbar
# 3. Seasonal factor:   c_j = average of the ratios of position j
#                       (the factors add up to N)
# 4. Forecast:          F_t = Dbar * c_j   (j = position of period t)
# =====================================================================


# ---------------------------------------------------------------------
# 1) HELPER FUNCTIONS
# ---------------------------------------------------------------------
seasonal_factors_run <- function(d, N) {
  n_cycles <- floor(length(d) / N)
  used <- d[1:(n_cycles * N)]                 # only complete seasons
  mean_d <- mean(used)
  ratio <- used / mean_d
  pos <- season_position(seq_along(used), N)
  factors <- tapply(ratio, pos, mean)
  factors <- as.numeric(factors) * N / sum(factors)   # sum = N
  list(mean = mean_d, factors = factors, ratio = ratio, n_used = length(used))
}


# ---------------------------------------------------------------------
# 2) SCREEN (UI)
# ---------------------------------------------------------------------
seasonal_factors_ui <- function(id) {
  ns <- NS(id)
  forecast_page(ns,
    "Seasonal factor c_j = average of D_t / (overall mean) for position j. F_t = mean x c_j.",
    numericInput(ns("N"), "Season length N (e.g. 4 = quarters, 12 = months)",
                 value = 4, min = 2, step = 1),
    helpText("This method has no smoothing constant to search for;",
             "only the season length N is needed.")
  )
}


# ---------------------------------------------------------------------
# 3) CALCULATIONS (SERVER)
# ---------------------------------------------------------------------
seasonal_factors_server <- function(id) {
  moduleServer(id, function(input, output, session) {
    demand <- series_input_server("data")

    result <- reactive({
      d <- demand(); n <- length(d)
      req(input$N)
      N <- as.integer(input$N)
      validate(need(N >= 2 && n >= N,
                    "The data must contain at least one complete season."))
      r <- seasonal_factors_run(d, N)
      pos <- season_position(1:n, N)
      h <- horizon(input)
      fpos <- season_position((n + 1):(n + h), N)
      ratio <- c(r$ratio, rep(NA, n - r$n_used))
      list(method  = paste0("Seasonal factors (quick and dirty), N = ", N),
           d = d, fitted = r$mean * r$factors[pos],
           future  = r$mean * r$factors[fpos],
           periods = 1:n,
           params  = data.frame(
             Parameter = c("Overall mean", paste0("c", 1:N)),
             Value = c(r$mean, r$factors)),
           detail  = data.frame("Season position" = pos,
                                "D_t / mean" = ratio,
                                "Factor c_j" = r$factors[pos],
                                check.names = FALSE))
    })

    render_forecast_results(output, result)
  })
}

# =====================================================================
# Topic: Aggregate planning with the transportation method
# Nahmias, Chapter 3
#
# Sources (rows):  starting inventory, and for every period t
#                  regular time RT_t, overtime OT_t, subcontracting SC_t
# Destinations:    the demand of every period (the last period also needs
#                  the required ending inventory) + "Unused capacity"
# Capacities:      RT_t = K n_t W     (W = workforce, constant)
#                  OT_t = overtime % x RT_t
#                  SC_t = subcontracting capacity per period
# Cell cost:       cost of the source + c_I x (periods held)
#                  = c_R / c_O / c_S + c_I (j - t);  j < t is not allowed
#                  (no backorders). Unused RT capacity costs c_U per unit.
# Solutions:
#   North-west corner: start at the top-left cell, give as much as
#     possible, then move right (demand met) or down (capacity used up).
#   Cheapest cell first (least-cost method): repeatedly give as much as
#     possible to the cheapest allowed cell. The result is checked with an
#     exact transportation LP (lpSolve::lp.transport).
# =====================================================================


# ---------------------------------------------------------------------
# 1) HELPER FUNCTIONS
# ---------------------------------------------------------------------

# Builds the transportation table: sources, demands and cell costs.
transportation_setup <- function(ap, W, ot_pct, sub_cap) {
  Tn <- length(ap$D); k <- ap$costs
  demand <- ap$D; demand[Tn] <- demand[Tn] + ap$IT
  src <- data.frame(label = character(0), type = character(0), period = integer(0),
                    capacity = numeric(0), cost = numeric(0), unused_cost = numeric(0))
  add <- function(label, type, t, cap, cost, unused) {
    src[nrow(src) + 1, ] <<- list(label, type, t, cap, cost, unused)
  }
  if (ap$I0 > 0) add("Starting inventory", "INV", 1L, ap$I0, 0, 0)
  for (t in 1:Tn) {
    rt <- ap$K * ap$days[t] * W
    add(paste("RT", ap$periods[t]), "RT", t, rt, k$reg, k$idle)
    if (ot_pct > 0) add(paste("OT", ap$periods[t]), "OT", t, ot_pct / 100 * rt, k$ot, 0)
    if (sub_cap > 0) add(paste("SC", ap$periods[t]), "SC", t, sub_cap, k$sub, 0)
  }
  cost <- matrix(NA_real_, nrow(src), Tn)
  for (i in seq_len(nrow(src))) {
    j <- src$period[i]:Tn
    cost[i, j] <- src$cost[i] + k$hold * (j - src$period[i])
  }
  list(src = src, demand = demand, cost = cost,
       unused = max(0, sum(src$capacity) - sum(demand)))
}

# Every period's demand must be covered by sources of that period or earlier.
transportation_feasible <- function(tp) {
  Tn <- length(tp$demand)
  cap_by_t <- vapply(1:Tn, function(t) sum(tp$src$capacity[tp$src$period == t]), numeric(1))
  all(cumsum(cap_by_t) >= cumsum(tp$demand) - 1e-6)
}

# North-west corner rule (the last column is "Unused capacity").
transportation_northwest <- function(tp) {
  supply <- tp$src$capacity
  dem <- c(tp$demand, tp$unused)
  X <- matrix(0, length(supply), length(dem))
  i <- 1; j <- 1
  while (i <= length(supply) && j <= length(dem)) {
    q <- min(supply[i], dem[j])
    X[i, j] <- q
    supply[i] <- supply[i] - q; dem[j] <- dem[j] - q
    if (supply[i] <= 1e-9) i <- i + 1 else j <- j + 1
  }
  X
}

# Cheapest cell first; leftover capacity goes to "Unused capacity".
transportation_least_cost <- function(tp) {
  supply <- tp$src$capacity
  dem <- tp$demand
  Tn <- length(dem)
  X <- matrix(0, length(supply), Tn + 1)
  cells <- which(!is.na(tp$cost), arr.ind = TRUE)
  cells <- cells[order(tp$cost[cells], cells[, "col"], cells[, "row"]), , drop = FALSE]
  for (k in seq_len(nrow(cells))) {
    i <- cells[k, "row"]; j <- cells[k, "col"]
    q <- min(supply[i], dem[j])
    if (q > 0) {
      X[i, j] <- X[i, j] + q
      supply[i] <- supply[i] - q; dem[j] <- dem[j] - q
    }
  }
  X[, Tn + 1] <- supply
  list(X = X, unmet = sum(dem))
}

# Exact optimum of the same transportation problem (for checking).
# One LP variable per allowed cell (cells with backorders are left out).
transportation_optimal <- function(tp) {
  C <- cbind(tp$cost, tp$src$unused_cost)
  cells <- which(!is.na(C), arr.ind = TRUE)
  nv <- nrow(cells)
  m <- nrow(C); n <- ncol(C)
  A <- matrix(0, m + n, nv)
  A[cbind(cells[, "row"], 1:nv)] <- 1            # each source ships its capacity
  A[cbind(m + cells[, "col"], 1:nv)] <- 1        # each destination receives its demand
  sol <- lpSolve::lp("min", C[cells], A, rep("=", m + n),
                     c(tp$src$capacity, tp$demand, tp$unused))
  if (sol$status != 0) return(NULL)
  X <- matrix(0, m, n)
  X[cells] <- sol$solution
  X
}

# Total cost of an allocation (cells used x their cost).
transportation_cost <- function(tp, X) {
  C <- cbind(tp$cost, tp$src$unused_cost)
  C[is.na(C)] <- 1e9
  sum(X * C)
}

# Turns an allocation into the usual plan table.
transportation_plan_table <- function(ap, tp, X, W) {
  Tn <- length(ap$D)
  used <- function(type) vapply(1:Tn, function(t) {
    rows <- which(tp$src$type == type & tp$src$period == t)
    if (length(rows) == 0) 0 else sum(X[rows, 1:Tn])
  }, numeric(1))
  rt_cap <- ap$K * ap$days * W
  ap_build_plan(ap, W, O = used("OT"), U = rt_cap - used("RT"), S = used("SC"))
}

# Allocation table for the screen.
transportation_show <- function(tp, X, ap) {
  Tn <- length(tp$demand)
  out <- as.data.frame(matrix("", nrow(X), Tn + 1), stringsAsFactors = FALSE)
  names(out) <- c(ap$periods, "Unused")
  for (i in seq_len(nrow(X))) for (j in 1:(Tn + 1)) {
    if (j <= Tn && is.na(tp$cost[i, j])) out[i, j] <- "x"
    else if (X[i, j] > 1e-9) out[i, j] <- format(round(X[i, j], 2), big.mark = ",")
  }
  cbind(Source = tp$src$label, out,
        Capacity = round(tp$src$capacity, 2))
}


# ---------------------------------------------------------------------
# 2) SCREEN (UI)
# ---------------------------------------------------------------------
transportation_plan_ui <- function(id) {
  ns <- NS(id)
  ap_page(ns,
    "Regular time, overtime and subcontracting of each period are the sources; the demands of the periods are the destinations.",
    numericInput(ns("W"), "Workforce W (constant, used for regular-time capacity)",
                 value = 300, min = 0, step = 1),
    numericInput(ns("ot_pct"), "Overtime capacity (% of regular-time capacity, 0 = none)",
                 value = 20, min = 0),
    numericInput(ns("sub_cap"), "Subcontracting capacity per period (units, 0 = none)",
                 value = 0, min = 0),
    extra_main = tagList(
      h4("Cell costs (x = not allowed: no backorders)"),
      tableOutput(ns("cost_matrix")),
      h4(textOutput(ns("nw_title"))),
      tableOutput(ns("nw_table")),
      h4(textOutput(ns("lc_title"))),
      tableOutput(ns("lc_table"))
    )
  )
}


# ---------------------------------------------------------------------
# 3) CALCULATIONS (SERVER)
# ---------------------------------------------------------------------
transportation_plan_server <- function(id, ap) {
  moduleServer(id, function(input, output, session) {
    num <- function(x) if (is.null(x) || is.na(x)) 0 else x

    # Suggest the starting workforce when the data changes
    observeEvent(tryCatch(ap()$W0, error = function(e) NULL), {
      updateNumericInput(session, "W", value = ap()$W0)
    })

    solved <- reactive({
      a <- ap_require(ap)
      W <- ceiling(num(input$W) - 1e-9)
      tp <- transportation_setup(a, W, num(input$ot_pct), num(input$sub_cap))
      validate(need(transportation_feasible(tp),
                    "Not enough capacity: some period's demand cannot be met without backorders. Increase W, overtime or subcontracting."))
      nw <- transportation_northwest(tp)
      lc <- transportation_least_cost(tp)
      opt <- transportation_optimal(tp)
      best <- lc$X
      note <- NULL
      if (lc$unmet > 1e-6 && !is.null(opt)) {
        best <- opt
        note <- "The cheapest-cell-first rule left some demand unmet, so the exact LP optimum is shown instead."
      } else if (!is.null(opt) && transportation_cost(tp, lc$X) > transportation_cost(tp, opt) + 1e-6) {
        note <- paste0("Note: the exact optimum (", round(transportation_cost(tp, opt), 2),
                       ") is cheaper than the cheapest-cell-first solution.")
      } else {
        note <- "The cheapest-cell-first solution is optimal (checked with an exact LP)."
      }
      list(a = a, W = W, tp = tp, nw = nw, best = best, note = note)
    })

    result <- reactive({
      s <- solved()
      list(title = paste0("Transportation method, W = ", s$W),
           plans = list("North-west corner" = transportation_plan_table(s$a, s$tp, s$nw, s$W),
                        "Cheapest cell first (optimal)" = transportation_plan_table(s$a, s$tp, s$best, s$W)),
           note = s$note)
    })

    output$cost_matrix <- renderTable({
      s <- solved()
      C <- s$tp$cost
      out <- as.data.frame(ifelse(is.na(C), "x", format(round(C, 2))), stringsAsFactors = FALSE)
      names(out) <- s$a$periods
      cbind(Source = s$tp$src$label, out, Unused = s$tp$src$unused_cost)
    })
    output$nw_title <- renderText({
      s <- solved()
      paste0("North-west corner solution (transportation cost ",
             format(round(transportation_cost(s$tp, s$nw), 2), big.mark = ","), ")")
    })
    output$nw_table <- renderTable({ s <- solved(); transportation_show(s$tp, s$nw, s$a) })
    output$lc_title <- renderText({
      s <- solved()
      paste0("Cheapest cell first solution (transportation cost ",
             format(round(transportation_cost(s$tp, s$best), 2), big.mark = ","), ")")
    })
    output$lc_table <- renderTable({ s <- solved(); transportation_show(s$tp, s$best, s$a) })

    render_ap_results(output, ap, result)
  })
}

# =====================================================================
# Topic: Weighted Moving Average - WMA(N)               (stationary series)
# Nahmias, Chapter 2
#
# F_t = w_1 D_{t-1} + w_2 D_{t-2} + ... + w_N D_{t-N}
#   w_1 is the weight of the most recent period, w_i >= 0, sum(w_i) = 1
# The forecast for every future period is the last WMA value.
# Best weights: every combination on a grid (step 0.05, or 0.1 for N = 5)
# is tried and the one with the smallest MAD / MSE / MAPE is kept.
# =====================================================================


# ---------------------------------------------------------------------
# 1) HELPER FUNCTIONS
# ---------------------------------------------------------------------

# Forecasts with weights w (w[1] = most recent). Length n + 1.
weighted_moving_average_forecast <- function(d, w) {
  n <- length(d); N <- length(w)
  F <- rep(NA_real_, n + 1)
  for (t in (N + 1):(n + 1)) {
    F[t] <- sum(w * d[(t - 1):(t - N)])
  }
  F
}

# All weight vectors of length N on a grid with the given step that add up to 1.
weight_grid <- function(N, step) {
  k <- round(1 / step)
  build <- function(parts, total) {
    if (parts == 1) return(matrix(total, 1, 1))
    do.call(rbind, lapply(0:total, function(first) {
      cbind(first, build(parts - 1, total - first))
    }))
  }
  g <- build(N, k) * step
  colnames(g) <- paste0("w", 1:N)
  as.data.frame(g)
}

# Reads "0.5, 0.3, 0.2" into a numeric vector.
parse_weights <- function(text) {
  parts <- strsplit(gsub(";", ",", text), ",")[[1]]
  suppressWarnings(as.numeric(trimws(parts)))
}


# ---------------------------------------------------------------------
# 2) SCREEN (UI)
# ---------------------------------------------------------------------
weighted_moving_average_ui <- function(id) {
  ns <- NS(id)
  forecast_page(ns,
    "F_t = w1 D(t-1) + w2 D(t-2) + ... + wN D(t-N). Weights add up to 1.",
    parameter_mode_ui(ns,
      manual = textInput(ns("weights"),
                         "Weights, most recent period first (comma separated)",
                         value = "0.5, 0.3, 0.2"),
      auto   = numericInput(ns("N"), "N (number of weights, 2 to 5)",
                            value = 3, min = 2, max = 5, step = 1)
    )
  )
}


# ---------------------------------------------------------------------
# 3) CALCULATIONS (SERVER)
# ---------------------------------------------------------------------
weighted_moving_average_server <- function(id) {
  moduleServer(id, function(input, output, session) {
    demand <- series_input_server("data")

    result <- reactive({
      d <- demand(); n <- length(d)
      search <- NULL
      if (input$mode == "manual") {
        w <- parse_weights(input$weights)
        validate(need(length(w) >= 1 && all(!is.na(w)),
                      "Type the weights as numbers separated by commas."),
                 need(all(w >= 0), "Weights cannot be negative."),
                 need(abs(sum(w) - 1) < 1e-6,
                      paste0("The weights must add up to 1 (now ", sum(w), ").")),
                 need(length(w) < n, "Too many weights for this data."))
      } else {
        req(input$N)
        N <- as.integer(input$N)
        validate(need(N >= 2 && N <= 5, "N must be between 2 and 5."),
                 need(N < n, "N must be smaller than the number of observations."))
        step <- if (N <= 4) 0.05 else 0.1
        grid <- weight_grid(N, step)
        search <- search_parameters(
          grid,
          function(p) forecast_errors(d, weighted_moving_average_forecast(d, unname(p)),
                                      (N + 1):n),
          input$criterion)
        w <- unlist(search[1, paste0("w", 1:N)])
      }
      w <- unname(w); N <- length(w)
      F <- weighted_moving_average_forecast(d, w)
      list(method  = paste0("Weighted moving average, weights = (",
                            paste(round(w, 3), collapse = ", "), ")"),
           d = d, fitted = F[1:n],
           future  = rep(F[n + 1], horizon(input)),
           periods = (N + 1):n,
           params  = data.frame(Parameter = paste0("w", 1:N, " (period t-", 1:N, ")"),
                                Value = w),
           search  = search)
    })

    render_forecast_results(output, result)
  })
}

# =====================================================================
# Topic: Winters' method - triple exponential smoothing (seasonal series)
# Nahmias, Chapter 2
#
# N = length of one season
# S_t = alpha (D_t / c_{t-N}) + (1 - alpha)(S_{t-1} + G_{t-1})   level
# G_t = beta (S_t - S_{t-1}) + (1 - beta) G_{t-1}                slope
# c_t = gamma (D_t / S_t) + (1 - gamma) c_{t-N}                  seasonal factor
# One-step forecast:  F_t = (S_{t-1} + G_{t-1}) c_{t-N}
# tau steps ahead:    F_{n+tau} = (S_n + tau G_n) c_{n+tau-N}
#
# Initial values:
#   S_0, G_0 : regression line D_t = a + b t  ->  S_0 = a, G_0 = b
#              (or typed by the user)
#   c_j      : average of D_t / (S_0 + G_0 t) over the periods of position j,
#              scaled so that the factors add up to N
# =====================================================================


# ---------------------------------------------------------------------
# 1) HELPER FUNCTIONS
# ---------------------------------------------------------------------
winters_initial_factors <- function(d, N, S0, G0) {
  t <- seq_along(d)
  ratio <- d / (S0 + G0 * t)
  raw <- tapply(ratio, season_position(t, N), mean)
  as.numeric(raw) * N / sum(raw)
}

winters_run <- function(d, N, alpha, beta, gamma, S0, G0, c0) {
  n <- length(d)
  S <- G <- F <- cc <- numeric(n)
  factors <- c0                  # the latest factor of every position
  S_prev <- S0; G_prev <- G0
  for (t in 1:n) {
    j <- season_position(t, N)
    F[t] <- (S_prev + G_prev) * factors[j]
    S[t] <- alpha * d[t] / factors[j] + (1 - alpha) * (S_prev + G_prev)
    G[t] <- beta * (S[t] - S_prev) + (1 - beta) * G_prev
    cc[t] <- gamma * d[t] / S[t] + (1 - gamma) * factors[j]
    factors[j] <- cc[t]
    S_prev <- S[t]; G_prev <- G[t]
  }
  list(S = S, G = G, c = cc, F = F, last_factors = factors)
}


# ---------------------------------------------------------------------
# 2) SCREEN (UI)
# ---------------------------------------------------------------------
winters_ui <- function(id) {
  ns <- NS(id)
  forecast_page(ns,
    "Level S, slope G and seasonal factors c are smoothed with alpha, beta, gamma. F = (S + tau G) c.",
    numericInput(ns("N"), "Season length N (e.g. 4 = quarters, 12 = months)",
                 value = 4, min = 2, step = 1),
    parameter_mode_ui(ns,
      manual = tagList(
        numericInput(ns("alpha"), "alpha (level)", value = 0.2,
                     min = 0.01, max = 1, step = 0.05),
        numericInput(ns("beta"), "beta (trend)", value = 0.1,
                     min = 0.01, max = 1, step = 0.05),
        numericInput(ns("gamma"), "gamma (seasonal factors)", value = 0.1,
                     min = 0.01, max = 1, step = 0.05)
      ),
      auto = helpText("The search may take a few seconds.")
    ),
    initial_values_ui(ns, slope = TRUE)
  )
}


# ---------------------------------------------------------------------
# 3) CALCULATIONS (SERVER)
# ---------------------------------------------------------------------
winters_server <- function(id) {
  moduleServer(id, function(input, output, session) {
    demand <- series_input_server("data")
    observeEvent(demand(), suggest_initial_values(session, demand()))

    result <- reactive({
      d <- demand(); n <- length(d)
      req(input$N)
      N <- as.integer(input$N)
      validate(need(N >= 2 && n >= 2 * N,
                    "The data must contain at least two complete seasons."))
      st <- initial_values(input, d)
      S0 <- st[["level"]]; G0 <- st[["slope"]]
      c0 <- winters_initial_factors(d, N, S0, G0)
      validate(need(all(is.finite(c0)) && all(c0 > 0),
                    "The initial line gives zero or negative values; check S0 and G0."))
      search <- NULL
      if (input$mode == "manual") {
        req(input$alpha, input$beta, input$gamma)
        alpha <- input$alpha; beta <- input$beta; gamma <- input$gamma
        validate(need(all(c(alpha, beta, gamma) > 0 & c(alpha, beta, gamma) <= 1),
                      "alpha, beta and gamma must be in (0, 1]."))
      } else {
        search <- withProgress(message = "Searching alpha, beta, gamma...", {
          search_smoothing_constants(
            c("alpha", "beta", "gamma"),
            function(p) forecast_errors(
              d, winters_run(d, N, p[["alpha"]], p[["beta"]], p[["gamma"]], S0, G0, c0)$F, 1:n),
            input$criterion, coarse = 0.1)
        })
        alpha <- search$alpha[1]; beta <- search$beta[1]; gamma <- search$gamma[1]
      }
      run <- winters_run(d, N, alpha, beta, gamma, S0, G0, c0)
      h <- horizon(input)
      tf <- (n + 1):(n + h)
      list(method  = paste0("Winters' method (alpha = ", alpha, ", beta = ", beta,
                            ", gamma = ", gamma, "), N = ", N),
           d = d, fitted = run$F,
           future  = (run$S[n] + (tf - n) * run$G[n]) * run$last_factors[season_position(tf, N)],
           periods = 1:n,
           params  = data.frame(
             Parameter = c("alpha", "beta", "gamma", "S0 (initial level)",
                           "G0 (initial slope)", paste0("initial c", 1:N)),
             Value = c(alpha, beta, gamma, S0, G0, c0)),
           detail  = data.frame("Season position" = season_position(1:n, N),
                                "S_t" = run$S, "G_t" = run$G, "c_t" = run$c,
                                check.names = FALSE),
           search  = search)
    })

    render_forecast_results(output, result)
  })
}
