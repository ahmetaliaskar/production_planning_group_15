# Every module builds a result list:
#   title  text
#   plans  named list of 1 or 2 plan tables, e.g.
#          list("Original" = ..., "Whole workers" = ...)
#   note   extra text (optional)

ap_results_ui <- function(ns) {
  tagList(
    h4(textOutput(ns("headline"))),
    p(textOutput(ns("note"))),
    plotOutput(ns("cum_plot"), height = "320px"),
    h4("Cost of each item"),
    tableOutput(ns("cost_table")),
    h4(textOutput(ns("plan_title_1"))),
    tableOutput(ns("plan_table_1")),
    h4(textOutput(ns("plan_title_2"))),
    tableOutput(ns("plan_table_2"))
  )
}

# Hides the overtime / idle / subcontract columns when they are all zero.
ap_display_plan <- function(plan) {
  for (col in c("Overtime", "Idle (units)", "Subcontract")) {
    if (all(abs(plan[[col]]) < 1e-9)) plan[[col]] <- NULL
  }
  num <- vapply(plan, is.numeric, logical(1))
  plan[num] <- lapply(plan[num], function(x) round(x, 2))
  plan
}

render_ap_results <- function(output, ap, result) {
  output$headline <- renderText({
    r <- result()
    tot <- vapply(r$plans, function(p) ap_costs(p, ap())[["Total"]], numeric(1))
    paste0(r$title, "  -  total cost: ",
           paste(paste0(names(tot), " ", format(round(tot, 2), big.mark = ",")),
                 collapse = "  |  "))
  })

  output$note <- renderText({
    r <- result()
    short <- vapply(r$plans, function(p) any(p$Inventory < -1e-6), logical(1))
    paste(c(r$note,
            if (any(short)) "Warning: inventory becomes negative (shortage) in some periods."),
          collapse = " ")
  })

  output$cum_plot <- renderPlot({
    r <- result(); a <- ap()
    Tn <- length(a$Dnet)
    cols <- c("#2F6FB0", "#B4501E")
    ys <- c(0, cumsum(a$Dnet), unlist(lapply(r$plans, function(p) p[["Cum. production"]])))
    plot(0:Tn, c(0, cumsum(a$Dnet)), type = "o", pch = 19, col = "grey30", lwd = 2,
         ylim = range(ys), xaxt = "n", xlab = "Period",
         ylab = "Cumulative units",
         main = "Cumulative production vs cumulative net demand")
    axis(1, at = 0:Tn, labels = c("Start", a$periods))
    for (i in seq_along(r$plans)) {
      lines(0:Tn, c(0, r$plans[[i]][["Cum. production"]]), type = "o",
            pch = 17, lty = i + 1, col = cols[i])
    }
    legend("topleft", bty = "n",
           legend = c("Cumulative net demand", paste("Cum. production -", names(r$plans))),
           col = c("grey30", cols[seq_along(r$plans)]),
           pch = c(19, rep(17, length(r$plans))), lty = c(1, seq_along(r$plans) + 1))
  })

  output$cost_table <- renderTable({
    r <- result(); a <- ap()
    costs <- lapply(r$plans, function(p) ap_costs(p, a))
    out <- data.frame(Item = names(costs[[1]]))
    for (nm in names(costs)) out[[nm]] <- round(unname(costs[[nm]]), 2)
    out
  })

  output$plan_title_1 <- renderText(paste("Plan -", names(result()$plans)[1]))
  output$plan_table_1 <- renderTable(ap_display_plan(result()$plans[[1]]))
  output$plan_title_2 <- renderText({
    p <- result()$plans
    if (length(p) >= 2) paste("Plan -", names(p)[2]) else ""
  })
  output$plan_table_2 <- renderTable({
    p <- result()$plans
    if (length(p) >= 2) ap_display_plan(p[[2]]) else NULL
  })
}

# The original plan and, if workers are fractional, the whole-worker plan.
ap_with_rounding <- function(original, rounded_fn) {
  W <- original$Workers
  if (is_whole(W)) {
    list(plans = list("Original" = original),
         note = "The number of workers is already a whole number in every period.")
  } else {
    list(plans = list("Original (fractional workers)" = original,
                      "Whole workers (rounded up)" = rounded_fn()),
         note = "Workers were fractional, so a second plan with the workers rounded up is shown.")
  }
}

# A complete page: the module's own controls on the left, results on the right.
ap_page <- function(ns, explanation, ..., extra_main = NULL) {
  sidebarLayout(
    sidebarPanel(helpText(explanation), ...,
                 helpText("Data, costs, K and plant data come from the 'Data and Costs' tab.")),
    mainPanel(ap_results_ui(ns), extra_main)
  )
}

# =====================================================================
# Topic: Box-Jenkins models - AR(p), MA(q), ARMA(p,q), ARIMA(p,d,q)
# Nahmias, Chapter 2
#
# AR(p):    D_t = mu + phi_1 D_{t-1} + ... + phi_p D_{t-p} + eps_t
# MA(q):    D_t = mu + eps_t - theta_1 eps_{t-1} - ... - theta_q eps_{t-q}
# ARMA:     both parts together
# ARIMA:    an ARMA(p,q) model for the series differenced d times
#           (d = 1: D_t - D_{t-1}, d = 2: difference of the differences)
#
# Model identification: ACF and PACF plots
#   AR(p): PACF cuts off after lag p, ACF dies down
#   MA(q): ACF cuts off after lag q, PACF dies down
# Parameters are estimated with R's arima() (maximum likelihood).
# Note: R writes the MA part with "+" signs, so its ma coefficients
#       are -theta of the textbook form.
#
# The same module is used four times (AR, MA, ARMA, ARIMA tabs);
# `type` decides which orders the user can choose.
# =====================================================================


# ---------------------------------------------------------------------
# 1) HELPER FUNCTIONS
# ---------------------------------------------------------------------

# Fits the model; returns NULL if R cannot estimate it.
box_jenkins_fit <- function(d, p, dd, q, include_mean = TRUE) {
  tryCatch(
    suppressWarnings(stats::arima(d, order = c(p, dd, q),
                                  include.mean = include_mean && dd == 0,
                                  method = "CSS-ML")),
    error = function(e) NULL)
}

# One-step forecasts in the data period: F_t = D_t - residual_t
box_jenkins_fitted <- function(d, fit) as.numeric(d - stats::residuals(fit))

# Which (p, d, q) combinations to try for each model type.
box_jenkins_grid <- function(type, pmax, dmax, qmax) {
  switch(type,
    AR    = expand.grid(p = 1:pmax, d = 0, q = 0),
    MA    = expand.grid(p = 0, d = 0, q = 1:qmax),
    ARMA  = expand.grid(p = 1:pmax, d = 0, q = 1:qmax),
    ARIMA = expand.grid(p = 0:pmax, d = 1:dmax, q = 0:qmax))
}

box_jenkins_search <- function(d, grid, include_mean, criterion) {
  rows <- lapply(seq_len(nrow(grid)), function(i) {
    p <- grid$p[i]; dd <- grid$d[i]; q <- grid$q[i]
    fit <- box_jenkins_fit(d, p, dd, q, include_mean)
    if (is.null(fit)) return(NULL)
    err <- forecast_errors(d, box_jenkins_fitted(d, fit), (dd + 1):length(d))
    data.frame(p = p, d = dd, q = q, AIC = fit$aic,
               MAD = err[["MAD"]], MSE = err[["MSE"]], MAPE = err[["MAPE"]])
  })
  out <- do.call(rbind, rows)
  if (is.null(out)) return(NULL)
  out <- out[order(out[[criterion]]), , drop = FALSE]
  rownames(out) <- NULL
  out
}


# ---------------------------------------------------------------------
# 2) SCREEN (UI)
# ---------------------------------------------------------------------
box_jenkins_ui <- function(id, type = "ARIMA") {
  ns <- NS(id)
  has_p <- type %in% c("AR", "ARMA", "ARIMA")
  has_d <- type == "ARIMA"
  has_q <- type %in% c("MA", "ARMA", "ARIMA")
  min_order <- if (type == "ARIMA") 0 else 1
  formula_text <- switch(type,
    AR    = "AR(p): D_t depends on its own p previous values.",
    MA    = "MA(q): D_t depends on the q previous random errors.",
    ARMA  = "ARMA(p,q): AR and MA parts together.",
    ARIMA = "ARIMA(p,d,q): ARMA(p,q) for the series differenced d times.")

  sidebarLayout(
    sidebarPanel(
      helpText(formula_text),
      series_input_ui(ns("data")),
      parameter_mode_ui(ns,
        manual = tagList(
          if (has_p) numericInput(ns("p"), "p (AR order)", value = 1,
                                  min = min_order, max = 6, step = 1),
          if (has_d) numericInput(ns("d"), "d (number of differences)", value = 1,
                                  min = 0, max = 2, step = 1),
          if (has_q) numericInput(ns("q"), "q (MA order)", value = 1,
                                  min = min_order, max = 6, step = 1)
        ),
        auto = tagList(
          if (has_p) numericInput(ns("pmax"), "Largest p to try", value = 3,
                                  min = 1, max = 6, step = 1),
          if (has_d) numericInput(ns("dmax"), "Largest d to try", value = 2,
                                  min = 1, max = 2, step = 1),
          if (has_q) numericInput(ns("qmax"), "Largest q to try", value = 3,
                                  min = 1, max = 6, step = 1),
          if (has_d) helpText("AIC values are only comparable between models",
                              "with the same d.")
        ),
        criteria = c("AIC", "MAD", "MSE", "MAPE")
      ),
      if (!has_d) checkboxInput(ns("mean"), "Include a constant (mean)", value = TRUE),
      horizon_ui(ns)
    ),
    mainPanel(
      h4("Model identification: ACF and PACF"),
      plotOutput(ns("acf_plot"), height = "300px"),
      h4("Parameter estimates"),
      tableOutput(ns("coef_table")),
      tableOutput(ns("model_table")),
      forecast_results_ui(ns)
    )
  )
}


# ---------------------------------------------------------------------
# 3) CALCULATIONS (SERVER)
# ---------------------------------------------------------------------
box_jenkins_server <- function(id, type = "ARIMA") {
  moduleServer(id, function(input, output, session) {
    demand <- series_input_server("data")
    include_mean <- reactive(if (type == "ARIMA") FALSE else isTRUE(input$mean))
    get_order <- function(name, default) {
      v <- input[[name]]
      if (is.null(v) || is.na(v)) default else as.integer(v)
    }

    # chosen orders and the fitted model
    model <- reactive({
      d <- demand()
      search <- NULL
      if (input$mode == "manual") {
        p  <- get_order("p", 0); dd <- get_order("d", 0); q <- get_order("q", 0)
        validate(need(p + q + dd > 0, "Choose at least one order greater than 0."))
      } else {
        grid <- box_jenkins_grid(type, get_order("pmax", 1), get_order("dmax", 1),
                                 get_order("qmax", 1))
        search <- withProgress(message = "Fitting models...",
                               box_jenkins_search(d, grid, include_mean(), input$criterion))
        validate(need(!is.null(search), "No model could be estimated for this data."))
        p <- search$p[1]; dd <- search$d[1]; q <- search$q[1]
      }
      validate(need(length(d) > p + dd + q + 2,
                    "Not enough observations for these orders."))
      fit <- box_jenkins_fit(d, p, dd, q, include_mean())
      validate(need(!is.null(fit), "R could not estimate this model. Try other orders."))
      list(fit = fit, p = p, d = dd, q = q, search = search)
    })

    output$acf_plot <- renderPlot({
      d <- demand()
      dd <- if (input$mode == "manual") get_order("d", 0) else model()$d
      series <- list("Series" = d)
      if (dd >= 1) series[["1st difference"]] <- diff(d)
      if (dd >= 2) series[["2nd difference"]] <- diff(d, differences = 2)
      par(mfrow = c(length(series), 2), mar = c(4, 4, 2.5, 1))
      for (nm in names(series)) {
        stats::acf(series[[nm]], main = paste("ACF -", nm))
        stats::pacf(series[[nm]], main = paste("PACF -", nm))
      }
    })

    output$coef_table <- renderTable({
      fit <- model()$fit
      est <- stats::coef(fit)
      if (length(est) == 0) return(data.frame(Note = "The model has no coefficients."))
      se <- sqrt(diag(fit$var.coef))
      data.frame(Coefficient = names(est), Estimate = est,
                 "Std. error" = se, "t value" = est / se, check.names = FALSE)
    }, digits = 4)

    output$model_table <- renderTable({
      fit <- model()$fit
      data.frame(Measure = c("sigma^2 (error variance)", "Log-likelihood", "AIC"),
                 Value = c(fit$sigma2, fit$loglik, fit$aic))
    }, digits = 3)

    result <- reactive({
      d <- demand(); n <- length(d)
      m <- model()
      pr <- stats::predict(m$fit, n.ahead = horizon(input))
      list(method  = paste0(type, " model: ARIMA(", m$p, ",", m$d, ",", m$q, ")"),
           d = d, fitted = box_jenkins_fitted(d, m$fit),
           future  = as.numeric(pr$pred),
           future_lower = as.numeric(pr$pred - 1.96 * pr$se),
           future_upper = as.numeric(pr$pred + 1.96 * pr$se),
           periods = (m$d + 1):n,
           params  = data.frame(Parameter = c("p", "d", "q"),
                                Value = c(m$p, m$d, m$q)),
           search  = m$search)
    })

    render_forecast_results(output, result)
  })
}

# =====================================================================
# Topic: Zero-inventory (chase) plan                    (heuristic plan)
# Nahmias, Chapter 3
#
# The workforce follows demand so that no inventory is carried:
#   W_t = D'_t / (K n_t)       (workers needed in period t)
#   H_t = max(W_t - W_{t-1}, 0),  F_t = max(W_{t-1} - W_t, 0)
# Whole workers: W_t is rounded up, ceil(D'_t / (K n_t)); the extra units
# produced are carried as inventory (as in the textbook table).
# =====================================================================


# ---------------------------------------------------------------------
# 1) HELPER FUNCTIONS
# ---------------------------------------------------------------------
chase_plan_workers <- function(ap) pmax(ap$Dnet, 0) / (ap$K * ap$days)


# ---------------------------------------------------------------------
# 2) SCREEN (UI)
# ---------------------------------------------------------------------
chase_plan_ui <- function(id) {
  ns <- NS(id)
  ap_page(ns, "W_t = D'_t / (K n_t): hire and fire every period so that production equals net demand.")
}


# ---------------------------------------------------------------------
# 3) CALCULATIONS (SERVER)
# ---------------------------------------------------------------------
chase_plan_server <- function(id, ap) {
  moduleServer(id, function(input, output, session) {
    result <- reactive({
      a <- ap_require(ap)
      W <- chase_plan_workers(a)
      r <- ap_with_rounding(ap_build_plan(a, W),
                            function() ap_build_plan(a, ceiling(W - 1e-9)))
      r$title <- "Zero-inventory (chase) plan"
      r
    })
    render_ap_results(output, ap, result)
  })
}

# =====================================================================
# Topic: Disaggregating the aggregate plan - square-root rule
# Nahmias, Chapter 3 (Bitran and Hax)
#
# The aggregate production X of a period is split among product families
# j = 1..J with setup cost K_j and demand lambda_j:
#   minimize  sum_j K_j lambda_j / Y_j      (setup cost of the runs)
#   s.t.      sum_j Y_j = X,   a_j <= Y_j <= b_j
# Without bounds the solution is the square-root rule:
#   Y_j = X * sqrt(K_j lambda_j) / sum_i sqrt(K_i lambda_i)
# With bounds: Y_j = min(b_j, max(a_j, c * sqrt(K_j lambda_j))), where the
# constant c is chosen so that the Y_j add up to X (found by bisection).
# =====================================================================


# ---------------------------------------------------------------------
# 1) HELPER FUNCTIONS
# ---------------------------------------------------------------------
disaggregation_split <- function(X, setup, demand, lower, upper) {
  r <- sqrt(setup * demand)
  y_of <- function(c) pmin(upper, pmax(lower, c * r))
  if (X <= sum(lower)) return(lower)
  if (X >= sum(upper)) return(upper)
  lo <- 0; hi <- 1
  while (sum(y_of(hi)) < X) hi <- hi * 2
  for (i in 1:200) {
    mid <- (lo + hi) / 2
    if (sum(y_of(mid)) < X) lo <- mid else hi <- mid
  }
  y_of(hi)
}

# Reads the family table typed in the text box.
parse_families <- function(text) {
  df <- utils::read.csv(text = text, strip.white = TRUE, check.names = FALSE)
  validate(need(ncol(df) >= 3, "Give at least: Family, Setup cost, Demand."))
  out <- data.frame(Family = as.character(df[[1]]),
                    Setup = as_number(df[[2]]),
                    Demand = as_number(df[[3]]),
                    Lower = if (ncol(df) >= 4) as_number(df[[4]]) else 0,
                    Upper = if (ncol(df) >= 5) as_number(df[[5]]) else Inf)
  out$Lower[is.na(out$Lower)] <- 0
  out$Upper[is.na(out$Upper)] <- Inf
  validate(need(all(!is.na(out$Setup) & !is.na(out$Demand)),
                "Setup cost and demand must be numbers."),
           need(all(out$Setup >= 0 & out$Demand >= 0), "Values cannot be negative."),
           need(all(out$Lower <= out$Upper), "A lower bound is larger than its upper bound."))
  out
}


